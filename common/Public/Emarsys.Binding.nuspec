<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>Maui.Binding.SAP.Emarsys</id>
    <version>0.2.0</version>
    <authors>Emarsys</authors>
    <description>MAUI Binding for SAP Emarsys.</description>
    <repository type="git" url="https://github.com/emartech/maui-binding-for-sap-emarsys" branch="main" />
    <releaseNotes>$releaseNotes$</releaseNotes>
    <tags>MAUI Emarsys SDK</tags>
    <dependencies>
      <group>
        <dependency id="Microsoft.Maui.Controls" version="8.0.3" />
      </group>
      <group targetFramework="net9.0-android24.0">
        <dependency id="Xamarin.AndroidX.Fragment.Ktx" version="1.8.4" />
        <dependency id="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" version="2.8.6" />
        <dependency id="Xamarin.Firebase.Messaging" version="124.0.2" />
      </group>
      <group targetFramework="net10.0-android24.0">
        <dependency id="Xamarin.AndroidX.Fragment.Ktx" version="1.8.4" />
        <dependency id="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" version="2.8.6" />
        <dependency id="Xamarin.Firebase.Messaging" version="124.0.2" />
      </group>
      <group targetFramework="net9.0-ios15.0">
      </group>
      <group targetFramework="net10.0-ios15.0">
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin/Release/net10.0-android/**" target="lib/net10.0-android24.0" />
    <file src="bin/Release/net10.0-ios/**" target="lib/net10.0-ios15.0" />
    <file src="bin/Release/net9.0-android/**" target="lib/net9.0-android24.0" />
    <file src="bin/Release/net9.0-ios/**" target="lib/net9.0-ios15.0" />
  </files>    
</package>
