<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    
    <PackageId>Maui.Binding.SAP.Emarsys</PackageId>
    <Version>0.1.1</Version>
    <Authors>Emarsys</Authors>
    <Description>MAUI Binding for SAP Emarsys.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/emartech/maui-binding-for-sap-emarsys</PackageProjectUrl>
    <RepositoryUrl>https://github.com/emartech/maui-binding-for-sap-emarsys</RepositoryUrl>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageTags>MAUI Emarsys SDK</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageChangelogFile>CHANGELOG.md</PackageChangelogFile>
  </PropertyGroup>

  <!-- Reference to Binding Internal project -->
  <ItemGroup>
    <ProjectReference Include="..\Internal\Emarsys.Binding.Internal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('android'))">
    <Compile Remove="**\iOS.cs" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('ios'))">
    <Compile Remove="**\Android.cs" />
  </ItemGroup>
  
  <!-- Package dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.3" />
  </ItemGroup>
  
  <!-- Android-specific dependencies -->
  <ItemGroup Condition="$(TargetFramework.Contains('android'))">
    <PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.8.4" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.8.6" />
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="124.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <IncludeReferencedProjects>true</IncludeReferencedProjects>
  </PropertyGroup>

  <!-- Exclude Swift module files that cause long path warnings - these are not needed at runtime -->
  <ItemGroup Condition="$(TargetFramework.Contains('ios'))">
    <!-- Exclude the entire Modules directory from the xcframework as it's not needed for consumption -->
    <None Remove="$(OutputPath)Emarsys.iOS.Binding.resources\MauiEmarsysiOS.xcframework\**\Modules\**" />
    <Content Remove="$(OutputPath)Emarsys.iOS.Binding.resources\MauiEmarsysiOS.xcframework\**\Modules\**" />

    <None Include="$(OutputPath)Emarsys.iOS.Binding.resources\MauiEmarsysiOS.xcframework\**\*" 
          Exclude="$(OutputPath)Emarsys.iOS.Binding.resources\MauiEmarsysiOS.xcframework\**\Modules\**" 
          Pack="true" 
          PackagePath="lib/$(TargetFramework)/Emarsys.iOS.Binding.resources/MauiEmarsysiOS.xcframework/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
